# Base URL of the ClausePilot FastAPI backend.
# Local development: http://localhost:8000 (also the default when unset in `npm run dev`).
# Production (Render static site): the deployed API's https URL, for example
#   https://clausepilot-api.onrender.com
# Vite bakes this value in at build time, so set it in the hosting dashboard
# before building, and rebuild after changing it.
VITE_API_BASE_URL=http://localhost:8000

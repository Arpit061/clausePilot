# Application
APP_NAME=clausepilot-api
APP_ENV=development
DEBUG=false

# Database
# Host port is 5433 (not 5432) in docker-compose.yml to avoid clashing with a
# locally installed PostgreSQL service. Adjust if your setup differs.
# Hosted URLs (postgres:// or postgresql://, e.g. from Render) are accepted as-is.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/clausepilot

# CORS: origins allowed to call the API from a browser. Comma-separated, or a
# JSON array. Local dev uses the Vite server; production should list only the
# deployed frontend origin.
CORS_ORIGINS=http://localhost:5173

# LLM provider (reserved for a future chat/agent milestone; not used yet)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Embeddings provider (semantic search)
# EMBEDDING_PROVIDER: "fake" (default) is a deterministic, network-free
# provider used for local dev and tests -- no API key required. Set it to
# "openai" plus EMBEDDING_API_KEY below to use real embeddings.
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=text-embedding-3-small
# API key for EMBEDDING_PROVIDER=openai. OPENAI_API_KEY is accepted as an alias.
EMBEDDING_API_KEY=
# Must match EMBEDDING_MODEL's real output dimension (1536 for
# text-embedding-3-small/ada-002, 3072 for text-embedding-3-large). This
# controls the database's vector column width; changing the model without
# updating this will cause embedding requests to fail loudly rather than
# silently store the wrong shape.
EMBEDDING_DIMENSION=1536

# Storage paths
# Leave UPLOAD_DIR unset (or empty) to use data/uploads in this repository.
# Local disk is not durable on Render; see the deployment notes before relying on it there.
UPLOAD_DIR=

# File storage for uploaded PDFs
# "local" (default): write to UPLOAD_DIR. Used for local development.
# "r2": store PDFs in a Cloudflare R2 bucket. Production should use this, since
#       local disk is not durable on Render. All R2_* values are then required.
STORAGE_BACKEND=local
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
